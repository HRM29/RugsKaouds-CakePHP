# CakePHP 3 - .gitignore

# Ignore vendor directory
/vendor/*

# Ignore sensitive configuration
/config/app.php

# Ignore tmp directory except for placeholder files
/tmp/cache/models/*
!/tmp/cache/models/empty
/tmp/cache/persistent/*
!/tmp/cache/persistent/empty
/tmp/cache/views/*
!/tmp/cache/views/empty
/tmp/sessions/*
!/tmp/sessions/empty
/tmp/tests/*
!/tmp/tests/empty

# Ignore logs directory except for placeholder files
/logs/*
!/logs/empty

# Ignore specific temporary files
/tmp/debug_kit.sqlite
/tmp/cache/myapp_cake_routes_route_collection
webroot/uploads/
webroot/uploads/
webroot/uploads/
